datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id            String   @id @default(cuid())
  slug          String   @unique
  businessName  String
  ownerName     String?
  designation   String?
  phone         String
  whatsapp      String?
  email         String?
  website       String?
  address       String?
  googleMapsUrl String?
  googlePlaceId      String?
  googleReviewWidget String?
  businessHours String?
  closingDay    String?
  logo               String?
  coverPhoto    String?
  about         String?
  category      String?
  yearEstd      String?
  socialLinks   String?
  services      String?
  gallery       String?
  theme         String   @default("theme1")
  themeColor    String   @default("#0ea5e9")
  isActive      Boolean  @default(true)
  ownerEmail    String?  @unique
  ownerPassword String?
  showCardViews Boolean  @default(true)
  cardViews     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        BusinessEvent[]
}

// Privacy-friendly click analytics for Theme 6 engagement tracking.
// Stores only the business + event type + timestamp — no IP, no user agent,
// no personal data. Written via POST /api/track (sendBeacon).
model BusinessEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  createdAt  DateTime @default(now())

  @@index([businessId, type])
  @@index([businessId, createdAt])
}
